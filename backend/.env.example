# ---------------------------------------------------------------------------
# backend/.env.example  ->  copy to backend/.env
#
#   cp backend/.env.example backend/.env
#
# `./setup.sh` does this for you and generates JWT_SECRET. An existing
# backend/.env is never overwritten, so re-running setup is safe.
#
# This is the template for running the backend DIRECTLY (uvicorn / --local):
# pydantic-settings reads `backend/.env` relative to the backend working
# directory, and nothing else.
#
# RUNNING UNDER DOCKER? Use the template in the repository ROOT instead
# (../.env.example -> ../.env). backend/.env is deliberately NOT visible to the
# container — .dockerignore keeps secrets out of image layers — so compose
# passes the environment in itself, and only the handful of values it forwards
# are settable that way. Every value below is still described here.
#
# Never commit a real .env.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# Must be >= 32 chars. Generate one:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Chat and the embeddings for newly uploaded documents. The app starts without
# it — the committed corpus was embedded offline — but no answer can be produced.
OPENAI_API_KEY=

# === DATABASE ==============================================================
# Local (non-Docker) setup creates one owner role. Create it once:
#   sudo -u postgres psql -c "CREATE ROLE qorvexa LOGIN PASSWORD 'qorvexa' CREATEDB;"
#   sudo -u postgres createdb -O qorvexa qorvexa
#
# search_path puts the analytics schema first and chat history (public) second.

# Owner role: schema load, auth lookups, chat-history and agenda writes.
DATABASE_URL=postgresql://qorvexa:qorvexa@127.0.0.1:5432/qorvexa?options=-csearch_path%3Dapp,public

# Read-only role: everything the agent's tool layer touches, SELECT only. This
# is a security boundary, not a convention — see
# docs/claude/security-invariants.md §1.5. The role is created by
# backend/etl/seed_app.sql, which also withholds app.reps.password_hash from it
# with a column-level grant.
DATABASE_URL_RO=postgresql://qorvexa_ro:qorvexa_ro@127.0.0.1:5432/qorvexa?options=-csearch_path%3Dapp,public

# Under Docker these two are built by docker-compose.yml instead, from
# POSTGRES_PASSWORD and RO_PASSWORD (both default to the values above). Override
# them in your shell or in a root-level .env:
#   POSTGRES_PASSWORD=...      # owner
#   RO_PASSWORD=...            # read-only role; seed_app.sql picks this up

# === MODEL =================================================================
MR_BOT_MODEL=gpt-5.6

# === APP ===================================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
ENVIRONMENT=development

# Send the session cookie only over HTTPS. MUST be true in production — the app
# refuses to start with ENVIRONMENT=production and this false, because the cookie
# carries the auth token. Left false here for local http development.
COOKIE_SECURE=false

# Optional error tracking. Enabling it also needs sentry-sdk installed
# (see backend/requirements.txt); without the package a set DSN just logs a
# warning.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Agenda (Gmail + Google Calendar). OPTIONAL: leave empty and mail/calendar are
# simply unavailable — the rep still gets tasks, and nothing errors. Settings
# says plainly what is missing rather than pretending.
#
# THESE ARE THE APPLICATION'S credentials, not a rep's. One OAuth client for the
# whole deployment, created once in the Google Cloud console — see
# docs/GOOGLE_SETUP.md. Each rep's own refresh token is encrypted and stored in
# agenda.connections; never here, and never in a log. A rep only ever clicks
# "Connect" in Settings.
#
# All three of CLIENT_ID, CLIENT_SECRET and ENCRYPTION_KEY together, or none:
# the app refuses to start half-configured.
#
# In production these come from the container environment or a secret manager,
# not from a file baked into an image.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must EXACTLY match a redirect URI registered in the Google console, or Google
# refuses the flow. Note the port: 8000 is the backend in local development;
# under Docker the app is served on 8080, so use
# http://localhost:8080/api/agenda/callback there.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/agenda/callback

# Encrypts stored refresh tokens (AES-256-GCM). base64url of exactly 32 bytes:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# No default: a connection stored under a key you then lose is unrecoverable.
AGENDA_ENCRYPTION_KEY=

# 'readonly' can read message bodies. 'metadata' sees only headers, labels and
# thread structure — enough for the whole triage view, because the categories are
# computed from who sent the last message and when. Only reading one thread
# needs bodies.
AGENDA_GMAIL_SCOPE=readonly

AGENDA_FOLLOWUP_DAYS=3
AGENDA_WINDOW_DAYS=14

# === THINGS YOU DO NOT HAVE TO CONFIGURE ===================================
# Listed so their absence reads as deliberate rather than forgotten.

# Qdrant needs no credentials. qdrant-client runs the REAL engine in-process:
# with QDRANT_URL empty the collection is persisted on disk at QDRANT_PATH
# (git-ignored, rebuilt by `python -m etl.ingest_docs`), and tests use ":memory:".
# Set these only when moving to a hosted cluster — then the API key is a real
# secret and belongs in .env, not here.
#QDRANT_URL=https://your-cluster.qdrant.io:6333
#QDRANT_API_KEY=
#QDRANT_PATH=./qdrant_data

# Timezone. "Today" and "overdue" resolve from a connected Google account's own
# calendar_tz FIRST — that is per-rep, so a field force spanning zones is correct
# with nothing set — and otherwise from the host (TZ, else /etc/localtime).
# Under Docker the container is UTC unless you pass TZ, which compose forwards.
#AGENDA_TIMEZONE=Asia/Kolkata

# Tuning knobs, all with working defaults. Shown with those defaults.
#JWT_TTL_HOURS=8                # how long a session lasts
#LOGIN_MAX_ATTEMPTS=5           # per client IP, then 429; the per-rep-code
#LOGIN_WINDOW_SECONDS=900       #   limiter uses double this, so one rep being
                                #   targeted cannot lock out a shared-NAT office
#POOL_MIN_SIZE=2                # psycopg connection pool, per DSN
#POOL_MAX_SIZE=10
#STATEMENT_TIMEOUT_MS=30000     # ceiling on any one query
#RUN_SQL_TIMEOUT_MS=5000        # tighter ceiling for model-composed SQL
