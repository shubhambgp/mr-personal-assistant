# ---------------------------------------------------------------------------
# .env.example (repository root)  ->  copy to .env
#
#   cp .env.example .env
#
# THIS FILE IS FOR DOCKER ONLY. Docker Compose reads a `.env` sitting beside
# docker-compose.yml and substitutes it into the file — it does NOT read
# backend/.env, because .dockerignore deliberately keeps secrets out of image
# layers.
#
# Running the backend directly with uvicorn instead? Use
# backend/.env.example -> backend/.env, which documents every setting the app
# has. This file lists ONLY the values docker-compose.yml interpolates, which is
# the complete set of what is settable under Docker. Everything else uses the
# defaults baked into docker-compose.yml or app/config.py.
#
# You can also just export these in your shell; compose reads the environment
# too. Never commit a real .env.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# Compose FAILS TO START without this — it is `${JWT_SECRET:?...}`, not a
# defaulted value, because a guessable session key is worse than no app.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Chat and the embeddings for newly uploaded documents. The stack starts and the
# UI works without it — the committed corpus was embedded offline — but no
# answer can be produced.
OPENAI_API_KEY=

# === DATABASE (optional — defaults work for a local demo) ==================
# The database is not published to the host, so these are reachable only from
# inside the compose network. Change them for anything real.
#
# POSTGRES_PASSWORD is the owner role. RO_PASSWORD is the SELECT-only role the
# agent's SQL runs as; backend/etl/seed_app.sql reads it when it creates that
# role, so the two halves cannot drift apart.
#POSTGRES_PASSWORD=qorvexa
#RO_PASSWORD=qorvexa_ro

# === AGENDA / GOOGLE (optional) ============================================
# Leave empty and mail/calendar are simply unavailable — the rep still gets
# tasks, and Settings says plainly what is missing. See docs/GOOGLE_SETUP.md.
#
# All three of CLIENT_ID, CLIENT_SECRET and ENCRYPTION_KEY together, or none:
# the app refuses to start half-configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts stored refresh tokens (AES-256-GCM). base64url of exactly 32 bytes:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# A connection stored under a key you then lose is unrecoverable.
AGENDA_ENCRYPTION_KEY=

# Must EXACTLY match a redirect URI registered in the Google console. Under
# Docker the browser talks to nginx on :8080, NOT the backend on :8000 — this is
# the single most common reason the flow fails. Compose already defaults to the
# line below, so you only need it here if you serve the app elsewhere.
#GOOGLE_REDIRECT_URI=http://localhost:8080/api/agenda/callback

# 'readonly' can read message bodies. 'metadata' sees only headers, labels and
# thread structure — enough for the whole triage view. Compose defaults to
# readonly.
#AGENDA_GMAIL_SCOPE=readonly

# === HOST ==================================================================
# A slim container image has no /etc/localtime, so the container is UTC unless
# you set this — and "today"/"overdue" are judged in this zone for any rep who
# has not connected a Google account (a connected account's own calendar_tz
# always wins, per rep).
#TZ=Asia/Kolkata

# === DEPLOYING SOMEWHERE REAL ==============================================
# All three are commented out on purpose: compose defaults suit local Docker,
# and these are the ones a real deployment has to change. See docs/DEPLOYMENT.md.

# The public origin. It is ALSO the OAuth landing page — the agenda callback
# redirects to the first origin listed, so leaving this at localhost means a rep
# who connects Gmail successfully lands nowhere.
#CORS_ORIGINS=https://assistant.example.com

# 'production' disables /docs, /redoc and /openapi.json, and makes COOKIE_SECURE
# mandatory — the app refuses to start without it. So set both, or neither.
#ENVIRONMENT=production
#COOKIE_SECURE=true

# Optional error tracking — empty means off. Turning it on also needs sentry-sdk
# uncommented in backend/requirements.txt, and a before_send redactor, because
# stack frames in this app hold mail bodies. See docs/SENTRY_SETUP.md.
#SENTRY_DSN=
