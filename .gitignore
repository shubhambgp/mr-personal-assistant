# --- secrets ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- node ---
node_modules/
dist/
*.tsbuildinfo

# --- retrieval ---
# The local Qdrant store is a build artefact: it is rebuilt by
# `python -m etl.ingest_docs data/literature --scope global`. The embeddings it
# would contain ARE committed, as evals/rag_corpus_vectors.npz, so the rebuild
# needs no API key.
qdrant_data/
backend/qdrant_data/

# A rep's own documents stay local. Ingest them with
#   python -m etl.ingest_docs data/literature.local --scope chair --chair-id <id>
# and they never enter the repository.
backend/data/literature.local/

# --- runtime output ---
backend/logs/
*.log

# --- never, under any circumstances ---
# The confidential source extract this project's synthetic data stands in for
# lives outside this repo entirely and must never enter it. These patterns are a
# backstop, not the mechanism — the mechanism is that those files are not here.
raw/
*.duckdb
*.duckdb.new
audit.jsonl

# --- editor / OS ---
.DS_Store
__MACOSX/
.idea/
.vscode/

# --- agenda (Google) ---
# The Google Cloud console downloads an OAuth client as client_secret_*.json.
# It is a credential, and it is the single most commonly committed one.
client_secret*.json
**/token.json
# Anything captured from a real mailbox while developing. Never committed — same
# rule as data/literature.local/. Committed fixtures are hand-authored.
backend/tests/fixtures/gmail.local/
backend/data/agenda.local/
*.har

